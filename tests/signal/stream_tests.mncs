mncs 0.18;

// Proofs of mncs.signal.windows/resample/ring/spectrum: structural facts
// exact (Hann endpoints, symmetry, lerp endpoints, ring wraparound,
// peak-pick ties), libm-adjacent values through tolerance.
module tests.signal.stream_tests;

use mncs.signal.windows;
use mncs.signal.resample;
use mncs.signal.ring;
use mncs.signal.spectrum;
use mncs.numerics.scalar_float;
use mncs.signal.types;
use mncs.test.assertions;
use mncs.test.suite;

test hann_endpoints_zero() -> (result: TestResult) {
    let a: bool = hann_weight(0, 8) == 0.0;
    let b: bool = a && hann_weight(7, 8) == 0.0;
    return from_assertion(equals_bool(true, b, 7401));
}

test hann_symmetric_peak() -> (result: TestResult) {
    // w(3) == w(4) for N=8 by symmetry; peak is 1 - epsilon at center.
    let a: bool = hann_weight(3, 8) == hann_weight(4, 8);
    let b: bool = a && within_tol(hann_weight(3, 8), 0.9504844339512095, 0.000000000001);
    return from_assertion(equals_bool(true, b, 7402));
}

test hamming_center_within() -> (result: TestResult) {
    return from_assertion(equals_bool(true, hamming_within(3, 8, 0.9544456792351128, 0.000000000001), 7403));
}

test lerp_endpoints_and_mid() -> (result: TestResult) {
    let a: bool = lerp(2.0, 6.0, 0.0) == 2.0;
    let b: bool = a && lerp(2.0, 6.0, 1.0) == 6.0;
    let c: bool = b && up2_mid(2.0, 6.0) == 4.0;
    return from_assertion(equals_bool(true, c, 7404));
}

test ring_push_read_sequence() -> (result: TestResult) {
    // Empty head 4 -> push lands slot 0; age 0 always reads head.
    let h0: u64 = push_head(4);
    let h1: u64 = push_head(h0);
    let a: bool = h0 == 0;
    let b: bool = a && h1 == 1;
    let c: bool = b && ring_slot(h1, 0) == 1;
    let d: bool = c && ring_slot(h1, 1) == 0;
    return from_assertion(equals_bool(true, d, 7405));
}

test ring_wraps_and_bounds() -> (result: TestResult) {
    let a: bool = ring_advance(3) == 0;
    let b: bool = a && ring_slot(0, 1) == 3;
    let c: bool = b && ring_slot(1, 9) == 4;
    let d: bool = c && ring_slot(7, 0) == 4;
    let e: bool = d && ring_count(9) == 4;
    let f: bool = e && ring_count(2) == 2;
    return from_assertion(equals_bool(true, f, 7406));
}

test sig_sqrt_matches_numerics() -> (result: TestResult) {
    // The local Newton mirror agrees with the canonical sqrt on the
    // documented domain (in-process test path resolves the import).
    let a: bool = sig_sqrt(25.0) == sqrt_value(25.0);
    let b: bool = a && within_tol(sig_sqrt(2.0), 1.4142135623730951, 0.000000000001);
    let c: bool = b && sig_sqrt(0.0) == 0.0;
    return from_assertion(equals_bool(true, c, 7408));
}

test mag2_and_peak() -> (result: TestResult) {
    let a: bool = mag2(3.0, 4.0) == 25.0;
    let b: bool = a && mag_within(3.0, 4.0, 5.0, 0.000000000001);
    let c: bool = b && peak_bin4(1.0, 5.0, 5.0, 2.0) == 1;
    let d: bool = c && peak_bin4(0.0, 0.0, 0.0, 9.0) == 3;
    return from_assertion(equals_bool(true, d, 7407));
}
